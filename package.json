{
  "name": "xsv-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "단일 HTML로 동작하는 CSV/TSV 조작 도구",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixture": "node fixtures/gen.mjs 100000 25 > fixtures/big.csv",
    "e2e": "node tests/e2e.mjs",
    "e2e:shots": "node tests/e2e.mjs --shots",
    "edge": "node tests/edge.mjs",
    "verify": "npm run check && npm run test && npm run build && npm run e2e && npm run edge"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.5",
    "@types/node": "^26.6.3",
    "puppeteer-core": "^25.4.0",
    "svelte": "^5.42.2",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^5.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@lezer/highlight": "^1.2.5",
    "@lucide/svelte": "^1.55.0",
    "@milkdown/crepe": "^7.22.3",
    "@milkdown/kit": "^7.22.3",
    "fflate": "^0.8.3",
    "pandoc-wasm": "1.1.0"
  }
}
